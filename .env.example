# Local settings for the scripts (copy to .env). Only keys and the corpus choice live here;
# everything corpus-specific (Pinecone namespace, models, chunking, bucket, descriptions) is in
# corpora/<name>.jsonc, with shared defaults in wrangler.jsonc.

# Which corpus every command uses by default (override with --corpus <file>).
CORPUS=corpora/mycorpus.jsonc

# ── API keys ──
VOYAGE_API_KEY=pa-...
PINECONE_API_KEY=pcsk_...
# GEMINI_API_KEY=...            # only for EMBED_PROVIDER=gemini

# ── Optional: ingest --upload-r2 (S3 API keys). Not needed for `npm run r2:upload`, which uses `wrangler login`.
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
